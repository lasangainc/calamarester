 *
 * esterOS minimalist installer stylesheet
 */

#mainApp {
    background-color: #525252;
    font-family: "Inter", sans-serif;
}

#viewManager,
#viewManagerStack {
    background-color: #EBEBEB;
    border: none;
}

#viewManager QWidget {
    background-color: transparent;
}

#viewManager QLabel {
    color: #1F1F1F;
    font-size: 13px;
    background: transparent;
}

#viewManager QLineEdit,
#viewManager QComboBox,
#viewManager QSpinBox {
    background-color: #FFFFFF;
    border: 1px solid #D8D8D8;
    border-radius: 18px;
    padding: 6px 16px;
    min-height: 28px;
    color: #1F1F1F;
}

#viewManager QComboBox::drop-down {
    border: none;
    width: 28px;
}

#viewManager QComboBox::down-arrow {
    image: none;
    border-left: 5px solid transparent;
    border-right: 5px solid transparent;
    border-top: 6px solid #555555;
    margin-right: 12px;
}

#viewManager QPushButton {
    background-color: #7B9FD4;
    color: #FFFFFF;
    border: none;
    border-radius: 22px;
    padding: 8px 24px;
    min-height: 32px;
    font-weight: 500;
}

#viewManager QPushButton:hover {
    background-color: #6A8EC3;
}

#viewManager QPushButton:disabled {
    background-color: #B0B0B0;
    color: #EEEEEE;
}

#viewManager QCheckBox,
#viewManager QRadioButton {
    color: #1F1F1F;
    spacing: 8px;
}

#viewManager QScrollArea {
    background-color: transparent;
    border: none;
}

#esterOSDeviceCombo {
    min-width: 260px;
    min-height: 40px;
    padding-left: 18px;
    padding-right: 18px;
}

PrettyRadioButton#esterOSOption {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 22px;
    min-height: 44px;
    padding: 4px 16px;
}

PrettyRadioButton#esterOSOption:hover {
    border-color: #7B9FD4;
}

PrettyRadioButton#esterOSOption QRadioButton {
    width: 0px;
    height: 0px;
    margin: 0px;
    padding: 0px;
    opacity: 0;
}

PrettyRadioButton#esterOSOption QRadioButton::indicator {
    width: 0px;
    height: 0px;
    border: none;
}

PrettyRadioButton#esterOSOption QLabel {
    font-size: 13px;
    color: #1F1F1F;
    padding-left: 4px;
}

PrettyRadioButton#esterOSOption:checked,
PrettyRadioButton#esterOSOption QRadioButton:checked {
    background-color: #FFFFFF;
}

PrettyRadioButton#esterOSOption QRadioButton:checked {
    border: 2px solid #7B9FD4;
}

#partitionBarView {
    background-color: #FFFFFF;
    border-radius: 16px;
}

#bootInfoIcon,
#bootInfoLabel,
#deviceInfoIcon,
#deviceInfoLabel {
    background: transparent;
}
