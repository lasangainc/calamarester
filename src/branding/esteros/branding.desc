#
# OriginUI branding — minimalist centered installer UI
---
componentName:  esteros

welcomeStyleCalamares:   false
welcomeExpandingLogo:    false

windowExpanding:    noexpand
windowSize:         480px,640px
windowPlacement:    center

sidebar:            none
navigation:         qml

strings:
    productName:         OriginUI
    shortProductName:    OriginUI
    version:             1.0
    shortVersion:        1.0
    versionedName:       OriginUI 1.0
    shortVersionedName:  OriginUI
    bootloaderEntryName: OriginUI
    productUrl:          ""
    supportUrl:          ""
    knownIssuesUrl:      ""
    releaseNotesUrl:     ""
    donateUrl:           ""

images:
    productIcon:         "icon.png"
    productLogo:         "images/emblem.png"

style:
   SidebarBackground:        "#EBEBEB"
   SidebarText:              "#1F1F1F"
   SidebarTextCurrent:       "#1F1F1F"
   SidebarBackgroundCurrent: "#7B9FD4"

slideshow:               "show.qml"
slideshowAPI:            2

uploadServer :
    type :    "none"
    url :     ""
    sizeLimit : -1
